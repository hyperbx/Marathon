<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Version>2.0.0</Version>
    <InformationalVersion>2.0.0</InformationalVersion>
    <Product>Marathon Command Line</Product>
    <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marathon\Marathon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Templates.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\Marathon.Shared\Marathon.Shared.projitems" Label="Shared" />

</Project>
